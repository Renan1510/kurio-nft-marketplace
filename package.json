{
  "name": "kurio-nft-marketplace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "msw init public --save",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/otimizar-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "lighthouse": "node scripts/lighthouse.mjs",
    "worker:init": "msw init public --save",
    "predev": "npm run worker:init",
    "prebuild": "npm run worker:init"
  },
  "dependencies": {
    "@mswjs/socket.io-binding": "^0.2.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@tanstack/react-query": "^5.70.0",
    "@tanstack/react-router": "^1.120.0",
    "axios": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "msw": "^2.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.20.0",
    "globals": "^15.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.2.0",
    "@lhci/cli": "^0.15.0",
    "lighthouse": "^12.8.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
